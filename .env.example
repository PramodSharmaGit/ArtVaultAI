# Copy this file to .env and fill in the values. Never commit .env.

# Supabase Postgres connection string (used by SQLAlchemy).
# Supabase dashboard -> Connect -> Session pooler. Format:
# postgresql+psycopg2://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Supabase project URL (used by Supabase Auth).
# Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase public key (anon / publishable) for Auth.
# Project Settings -> API Keys. Do NOT use the service_role / secret key here.
SUPABASE_KEY=
